  .skills-container {
    padding: var(--spacing-3xl) 0;
    background: var(--color-bg);
    border-top: 1px solid var(--color-border);
  }

  .skills-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: var(--spacing-lg);
    padding: 0 var(--spacing-md);
    max-width: 1400px;
