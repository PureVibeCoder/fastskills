---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import PlatformCapabilities from '../components/PlatformCapabilities.astro';
import MultiPlatform from '../components/MultiPlatform.astro';
import WhyChoose from '../components/WhyChoose.astro';
import SkillSources from '../components/SkillSources.astro';
import AllPackages from '../components/AllPackages.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import TagFilter from '../components/TagFilter.astro';
import SkillGrid from '../components/SkillGrid.astro';
import Search from '../components/Search.astro';
import { skills } from '../data/skills';
import { categories } from '../data/categories';
import { getSkillTags } from '../utils/skill-tags';
import type { ClientSkillListItem } from '../utils/scenario-packs';

// 客户端脚本仅用元数据（不含 content），下载走 /api/skill-markdown
const skillsForClient: ClientSkillListItem[] = skills.map((skill) => ({
  id: skill.id,
  name: skill.name,
  description: skill.description,
  category: {
    id: skill.category.id,
    name: skill.category.name,
    icon: skill.category.icon
  },
  triggers: skill.triggers,
  source: skill.source,
  priority: skill.priority
}));

// 准备搜索用的技能数据（只包含搜索需要的字段）
const searchSkills = skills.map(skill => ({
  id: skill.id,
  name: skill.name,
  description: skill.description,
  category: { name: skill.category.name, icon: skill.category.icon },
  triggers: skill.triggers
}));

const categoryById = new Map(categories.map((c) => [c.id, c]));
const tagSlugSet = new Set<string>();
for (const s of skills) {
  for (const t of getSkillTags(s)) tagSlugSet.add(t);
}
const libraryTagItems = [...tagSlugSet].sort().map((id) => ({
  id,
  label: categoryById.get(id)?.name ?? id
}));
---

<Layout
  title="FastSkills - 智能技能编排控制器"
  canonicalUrl={new URL(Astro.url.pathname, Astro.site)}
>
  <Hero />

  <PlatformCapabilities />

  <MultiPlatform />

  <section id="features" class="features-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">
          <span class="bracket">[</span> SYSTEM_CORE_FEATURES <span class="bracket">]</span>
        </h2>
      </div>
      <div class="features-grid">
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">🗂️</div>
          </div>
          <h3 class="feature-title">SKILL_AGGREGATION</h3>
          <p class="feature-description">汇集 15+ 个 GitHub 高星开源项目的 276+ 精选技能，按 20 大类别科学分类</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">📦</div>
          </div>
          <h3 class="feature-title">SCENARIO_PACKS</h3>
          <p class="feature-description">精心打造 25+ 个场景化技能包，覆盖开发、科研、办公等多个领域</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">🔍</div>
          </div>
          <h3 class="feature-title">SMART_SEARCH</h3>
          <p class="feature-description">支持按名称、描述、分类快速定位所需技能</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">⬇️</div>
          </div>
          <h3 class="feature-title">SECURE_INTEGRATION</h3>
          <p class="feature-description">提供技能下载并倡导安全审查，支持手动集成到本地环境</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">📚</div>
          </div>
          <h3 class="feature-title">FULL_DOCUMENTATION</h3>
          <p class="feature-description">每个技能都有完整的文档和使用示例</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon-wrapper">
            <div class="feature-icon">🎯</div>
          </div>
          <h3 class="feature-title">SMART_ROUTING</h3>
          <p class="feature-description">智能技能路由，自动检测意图并加载相关技能，一行安装即可使用</p>
        </div>
      </div>
    </div>
  </section>

  <WhyChoose />

  <SkillSources />

  <AllPackages />

  <div class="skills-container">
    <div class="container">
      <div class="skills-header">
        <h2 class="section-title terminal-style">
          <span class="prompt">&gt;</span> ACCESS_SKILL_LIBRARY<span class="cursor">_</span>
        </h2>
        <button class="btn download-pack-btn" id="download-pack">
          <span class="btn-icon">📦</span> INITIALIZE_DOWNLOAD
        </button>
      </div>
      <Search skills={searchSkills} />
      <CategoryFilter categories={categories} selectedCategory={null} />
      <TagFilter tags={libraryTagItems} />
    </div>
    <SkillGrid skills={skills} selectedCategory={null} />
  </div>
</Layout>

<style>
  .features-section {
    padding: var(--spacing-3xl) 0;
    background: var(--color-bg-secondary);
    position: relative;
    overflow: hidden;
  }

  .features-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-primary), transparent);
    opacity: 0.3;
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--spacing-3xl);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }

  .bracket {
    color: var(--color-primary);
    font-family: var(--font-mono);
  }

