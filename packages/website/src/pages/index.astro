<script type="module" define:vars={{ skillsForClient }}>
  import {
    scenarioSkillPacks,
    filterSkillsForScenarioPack
  } from '../utils/scenario-packs.ts';

  const skillsData = skillsForClient;

  async function fetchSkillMarkdown(skillId) {
    const res = await fetch(`/api/skill-markdown?id=${encodeURIComponent(skillId)}`);
    if (!res.ok) return null;
    return await res.text();
  }

  function fallbackMarkdown(skillId, skillName) {
    return `---
name: ${skillId}
description: ${skillName}
---

# ${skillName}

This is a skill downloaded from FastSkills.

## Description

Please refer to the original source for more details.

---

FastSkills: https://github.com/PureVibeCoder/fastskills`;
  }

  function getActiveCategory() {
    return document.querySelector('.category-button.active')?.dataset.category || 'all';
  }

  function getActiveFilterTags() {
    return [...document.querySelectorAll('.tag-filter-button.active')]
      .map((b) => b.dataset.tag)
      .filter(Boolean);
  }

  function categoryMatchesWrapper(wrapper, categoryId) {
    if (categoryId === 'all') return true;
    if (wrapper.dataset.category === categoryId) return true;
    const extras = (wrapper.dataset.extraCategories || '').split(',').filter(Boolean);
    return extras.includes(categoryId);
  }

  function tagMatchesWrapper(wrapper, activeTags) {
    if (!activeTags.length) return true;
    const slugs = (wrapper.dataset.filterTags || '').split(',').filter(Boolean);
    return activeTags.some((t) => slugs.includes(t));
  }

  function applyLibraryFilters() {
    const categoryId = getActiveCategory();
    const activeTags = getActiveFilterTags();
    document.querySelectorAll('.skill-wrapper[data-skill-id]').forEach((wrapper) => {
      const ok =
        categoryMatchesWrapper(wrapper, categoryId) && tagMatchesWrapper(wrapper, activeTags);
      wrapper.style.display = ok ? '' : 'none';
    });
    announceSkillCount();
  }

  window.applyLibraryFilters = applyLibraryFilters;

  function announceSkillCount() {
    const el = document.getElementById('skills-count-live');
    if (!el) return;
    const visible = [...document.querySelectorAll('.skill-wrapper[data-skill-id]')].filter(
      (w) => (w).style.display !== 'none'
    ).length;
    el.textContent = `当前显示 ${visible} 个技能`;
  }

  document.addEventListener('click', (e) => {
    const target = e.target;
    const categoryButton = target.closest('.category-button');
    if (categoryButton) {
      document.querySelectorAll('.category-button').forEach((btn) => {
        btn.classList.remove('active');
      });
      categoryButton.classList.add('active');
      applyLibraryFilters();
      return;
    }

    const tagBtn = target.closest('.tag-filter-button');
    if (tagBtn) {
      tagBtn.classList.toggle('active');
      applyLibraryFilters();
    }
  });

  // 创建模态框工具函数
  function createModal(config) {
    const modalHtml = `
      <div class="modal-overlay" id="${config.id}">
        <div class="modal-content">
          <div class="modal-header">
            <h2>${config.title}</h2>
            <button class="modal-close">&times;</button>
          </div>
          <div class="modal-body">${config.content}</div>
        </div>
      </div>
    `;

    document.body.insertAdjacentHTML('beforeend', modalHtml);

    const modal = document.getElementById(config.id);
    const closeBtn = modal?.querySelector('.modal-close');

    const close = () => {
      modal?.remove();
      config.onClose?.();
    };

    closeBtn?.addEventListener('click', close);
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) close();
    });

    return { modal, close };
  }

  function triggerDownloadMarkdown(skillId, markdown) {
    const blob = new Blob([markdown], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${skillId}-SKILL.md`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  document.addEventListener('click', (e) => {
    const downloadBtn = e.target.closest('.btn-download');
    if (!downloadBtn || downloadBtn.closest('#pack-modal')) return;

    const skillId = downloadBtn.dataset.skillId;
    const skillName = downloadBtn.dataset.skillName;
    if (!skillId) return;

    e.preventDefault();

    if (downloadBtn.dataset.downloading === '1') return;
    downloadBtn.dataset.downloading = '1';

    void (async () => {
      try {
        let markdown = await fetchSkillMarkdown(skillId);
        if (!markdown) {
          markdown = fallbackMarkdown(skillId, skillName || skillId);
        }
        triggerDownloadMarkdown(skillId, markdown);

        const originalText = downloadBtn.textContent;
        downloadBtn.textContent = '已下载!';
        downloadBtn.classList.remove('btn-primary');
        downloadBtn.classList.add('btn-success');

        setTimeout(() => {
          downloadBtn.textContent = originalText;
          downloadBtn.classList.remove('btn-success');
          downloadBtn.classList.add('btn-primary');
          delete downloadBtn.dataset.downloading;
        }, 2000);
      } catch {
        delete downloadBtn.dataset.downloading;
      }
    })();
  });

  async function downloadScenarioSkillPack(skills, packName) {
    const JSZip = (await import('jszip')).default;

    const zip = new JSZip();

    const skillContents = await Promise.all(
      skills.map(async (skill) => {
        let content = await fetchSkillMarkdown(skill.id);
        if (!content) {
          content = fallbackMarkdown(skill.id, skill.name);
        }
        return { id: skill.id, name: skill.name, content };
      })
    );

    skillContents.forEach(skill => {
      zip.file(`${skill.id}/SKILL.md`, skill.content);
    });

    const readme = `# ${packName}

本技能包由 FastSkills (https://github.com/PureVibeCoder/fastskills) 聚合提供，共包含 ${skills.length} 个技能。

> [!CAUTION]
> **安全警告**：本技能包收集自第三方开源项目。在使用之前，请务必对技能目录下的 \`SKILL.md\` 文件进行安全审查，确保其指令、触发器和操作指南符合您的预期，且不会执行恶意代码。

## 包含的技能
${skills.map(s => `- **${s.name}** (\`${s.id}\`)`).join('\n')}

## 集成方法

1. 解压本文件
2. 将需要的技能目录复制到您的全局技能目录 (\`~/.claude/skills/\`) 或项目目录 (\`.claude/skills/\`)
3. 重新启动 Claude Code`;
    zip.file('README.md', readme);

    const content = await zip.generateAsync({ type: 'blob' });
    const url = URL.createObjectURL(content);
    const link = document.createElement('a');
    link.href = url;
    link.download = `${packName}-skills-pack.zip`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  }

  // ── 搜索网格同步：监听 skill-search 事件，过滤并重排主网格 ──
  let savedCategory = 'all';
  let prevSearchQuery = '';

  document.addEventListener('skill-search', (e) => {
    const { query, results } = e.detail;
    const wrappers = document.querySelectorAll('.skill-wrapper[data-skill-id]');

    if (!query.trim()) {
      // 恢复：清除所有排序和显隐状态
      wrappers.forEach(w => {
        w.style.order = '';
        w.style.display = '';
      });

      // 恢复分类按钮 active 状态后按分类+标签重算显隐
      document.querySelectorAll('.category-button').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.category === savedCategory);
      });
      applyLibraryFilters();

      prevSearchQuery = '';
      announceSkillCount();
      return;
    }

    // 首次激活搜索（从空切换到非空）：保存当前分类状态
    if (!prevSearchQuery.trim() && query.trim()) {
      const activeBtn = document.querySelector('.category-button.active');
      savedCategory = activeBtn?.dataset.category || 'all';

      // 视觉上切换到 ALL（搜索覆盖分类过滤）
      document.querySelectorAll('.category-button').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.category === 'all');
      });

      document.querySelectorAll('.skill-wrapper[data-skill-id]').forEach((w) => {
        w.style.display = '';
      });
    }

    prevSearchQuery = query;

    const rankMap = new Map(results.map(({ id }, i) => [id, i]));

    wrappers.forEach(w => {
      const id = w.dataset.skillId;
      if (rankMap.has(id)) {
        w.style.order = String(rankMap.get(id) + 1);
        w.style.display = '';
      } else {
        w.style.order = '';
        w.style.display = 'none';
      }
    });
    announceSkillCount();
  });

  // 技能包下载功能
  const downloadPackBtn = document.getElementById('download-pack');
  if (downloadPackBtn) {
    downloadPackBtn.addEventListener('click', async () => {
      const packList = Object.entries(scenarioSkillPacks).map(([key, pack]) => `
        <button class="pack-button" data-pack="${key}">
          <div class="pack-name">${pack.name}</div>
          <div class="pack-description">${pack.description}</div>
        </button>
      `).join('');

      const { modal, close } = createModal({
        id: 'pack-modal',
        title: '下载技能包',
        content: `
          <p class="modal-description">选择要下载的技能包：</p>
          <div class="pack-list">${packList}</div>
        `
      });

      modal?.querySelectorAll('.pack-button').forEach(button => {
        button.addEventListener('click', async () => {
          const packKey = button.dataset.pack;
          const filteredSkills = filterSkillsForScenarioPack(skillsData, packKey);
          const packName = button.querySelector('.pack-name')?.textContent || 'skills';

          await downloadScenarioSkillPack(filteredSkills, packName);

          close();
        });
      });
    });
  }

  announceSkillCount();
</script>
