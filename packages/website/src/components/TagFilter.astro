---
export interface TagFilterItem {
  id: string;
  label: string;
}

interface Props {
  tags: TagFilterItem[];
}

const { tags } = Astro.props;
---

<div class="tag-filter-container animate-in delay-2">
  <div class="tag-filter-label">
    <span class="prompt">#</span> FILTER_TAGS <span class="hint">(多选，OR)</span>
  </div>
  <div class="tag-scroll-area">
    {tags.map((t) => (
      <button type="button" class="tag-filter-button" data-tag={t.id}>
        {t.label}
      </button>
    ))}
  </div>
</div>

<style>
  .tag-filter-container {
    width: 100%;
    margin-bottom: var(--spacing-lg);
  }

  .tag-filter-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-dim);
    margin-bottom: var(--spacing-sm);
    margin-left: var(--spacing-xs);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .prompt {
    color: var(--color-primary);
    font-weight: bold;
  }

  .hint {
    text-transform: none;
    letter-spacing: 0.04em;
    font-size: 0.65rem;
    color: var(--color-text-muted);
  }

  .tag-scroll-area {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    gap: var(--spacing-xs);
    padding: var(--spacing-sm) var(--spacing-md);
    background: var(--color-bg);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    scrollbar-width: none;
  }

  .tag-scroll-area::-webkit-scrollbar {
    display: none;
  }

  .tag-filter-button {
    flex: 0 0 auto;
    padding: 0.35rem 0.75rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all 0.2s var(--ease-out-expo);
    white-space: nowrap;
  }

  .tag-filter-button:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tag-filter-button.active {
    background: var(--color-primary-dim);
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .tag-scroll-area {
      flex-wrap: wrap;
      overflow-x: visible;
      justify-content: center;
    }

    .tag-filter-label {
      justify-content: center;
    }
  }
</style>
